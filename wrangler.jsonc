{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeos",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifeos",
      "database_id": "dd238825-b299-443d-90df-54f943382285"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
